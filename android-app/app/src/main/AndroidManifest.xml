<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Para mandar el audio del celular a la PC.
         RECORD_AUDIO suena raro acá porque no grabamos el micrófono, pero es
         el permiso que Android exige también para capturar lo que reproducen
         otras apps. La captura en sí la habilita el cartel del sistema. -->
    <!-- Sólo para leer el QR que muestra la PC al emparejar. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- El servicio en primer plano necesita mostrar una notificación. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Para pedirle al usuario que saque la app de la optimización de
         batería. Sin esto, algunos Android (Motorola entre ellos) matan el
         Servicio de Accesibilidad apenas la app pasa un rato en segundo
         plano, y hay que reactivarlo a mano en Ajustes cada vez. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="true"
        android:label="PortalDroid"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".TouchAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- La pantalla de escaneo, fijada en vertical. La que trae la
             librería sale horizontal y es incómoda para apuntar al monitor. -->
        <activity
            android:name=".EscanerVertical"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:exported="false" />

        <service
            android:name=".AudioStreamService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

    </application>
</manifest>
